# Examples only. PowerShell does not load this file automatically.
DB_URL=jdbc:postgresql://127.0.0.1:5432/upimesh
DB_USERNAME=upimesh
DB_PASSWORD=replace-with-your-local-password

# Dedicated integration-test database; never point tests at application data.
PG_TEST_URL=jdbc:postgresql://127.0.0.1:5432/upimesh_test
PG_TEST_USERNAME=upimesh_test
PG_TEST_PASSWORD=replace-with-your-local-test-password

# Shared bridge/metrics credential, separate from PostgreSQL passwords.
BRIDGE_API_KEY=replace-with-a-long-random-secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_NAMESPACE=upimesh:demo
# Set credentials for secured deployments; the loopback-only local demo has none.
REDIS_USERNAME=
REDIS_PASSWORD=
